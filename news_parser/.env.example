# --- Telegram (https://my.telegram.org/apps) ---
# API ID и Hash приложения
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
# Номер телефона аккаунта (для первой авторизации), формат: +79991234567
TELEGRAM_PHONE=+79991234567
# Путь к файлу сессии Telethon (создаётся при первом входе)
TELEGRAM_SESSION_PATH=./data/telegram.session

# Прокси (опционально): http://host:port или socks5://host:port
TELEGRAM_PROXY=

# --- LLM (любой OpenAI-совместимый API) ---
# Примеры base_url:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   vLLM:       http://localhost:8000/v1
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# Для локальных моделей без авторизации ключ можно оставить пустым
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# --- База данных ---
DATABASE_URL=sqlite+aiosqlite:///./data/news.db

# --- Парсер ---
# Интервал фонового парсинга каналов (минуты)
PARSE_INTERVAL_MINUTES=30
# Сколько последних сообщений забирать с канала за один проход
FETCH_LIMIT_PER_CHANNEL=200
# Интервал пересчёта топиков LLM (минуты)
TOPICS_REFRESH_INTERVAL_MINUTES=60

# --- API-сервер ---
API_HOST=0.0.0.0
API_PORT=8000

# --- S3 (Cloud.ru OBS) ---
S3_ENDPOINT_URL=...
S3_BUCKET=...
S3_PREFIX=...
S3_REGION=...
S3_ACCESS_KEY=
S3_SECRET_KEY=
