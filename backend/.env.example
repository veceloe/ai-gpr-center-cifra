# --- LLM: основной провайдер (любой OpenAI-совместимый API) ---
# base_url примеры: https://api.openai.com/v1 · https://openrouter.ai/api/v1 · http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_VERIFY_TLS=true
LLM_MAX_RETRIES=1
LLM_CACHE_ENABLED=true

# --- LLM: резервный провайдер (ADR-0006) ---
# Демо не должно зависеть от доступности одного API. Оставьте пустым, чтобы отключить.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# --- Хранилище и API ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
API_HOST=0.0.0.0
API_PORT=8000

# --- Сбор ---
POLL_INTERVAL_MEDIA_MIN=15
POLL_INTERVAL_REGULATOR_MIN=60
FETCH_LIMIT_PER_SOURCE=50

# --- Telegram (ADR-0008) ---
# Сессия создаётся один раз локально: python -m src.cli telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_STRING_SESSION=
TELEGRAM_PROXY=
